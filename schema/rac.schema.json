{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RoomAsCode",
  "description": "Room as Code (RaC) v1.0 - 방탈출 닫힌 세계 선언적 공간 및 인과율 스키마 규약",
  "type": "object",
  "required": ["version", "theme", "spaces", "passages", "logicGraph"],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "theme": {
      "type": "object",
      "required": ["id", "title", "durationMinutes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string" },
        "genre": { "type": "string", "enum": ["Horror", "Mystery", "SciFi", "Emotional", "Adventure"] },
        "durationMinutes": { "type": "integer", "minimum": 10, "maximum": 180 }
      }
    },
    "spaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "layer", "wallHeight", "polygon"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "layer": { "type": "integer", "default": 0 },
          "floorHeight": { "type": "number", "default": 0.0 },
          "wallHeight": { "type": "number", "minimum": 2.0, "maximum": 5.0, "default": 2.6 },
          "polygon": {
            "type": "array",
            "minItems": 3,
            "description": "X-Z 평면상의 바닥 꼭짓점 좌표 배열 [[x, z], ...]",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "floorHole": {
            "type": "object",
            "description": "복층 사다리/계단 관통 구멍 (X-Z 중심 좌표 및 크기)",
            "properties": {
              "pos": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
              "size": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
            }
          },
          "materials": {
            "type": "object",
            "description": "공간 벽·바닥 PBR 텍스처 프리셋 및 색조 온톨로지",
            "properties": {
              "wall": { "type": "string", "enum": ["concrete", "plaster", "wood", "tile", "surgicalSteel", "rustedMetal"], "default": "plaster" },
              "floor": { "type": "string", "enum": ["tile", "concrete", "wood", "surgicalSteel", "rustedMetal"], "default": "tile" },
              "wallTint": { "type": "string" },
              "floorTint": { "type": "string" }
            }
          },
          "props": {
            "type": "array",
            "description": "공간 내에 배치된 물리적 가구, 기물 및 단서 담지체(Prop)",
            "items": {
              "type": "object",
              "required": ["id", "transform"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "model": { "type": "string" },
                "type": { "type": "string" },
                "targetClueId": { "type": "string", "description": "이 소품이 운반하는 논리 단서 ID" },
                "targetObjId": { "type": "string", "description": "이 소품이 얹혀있는 부모 가구 기물 ID" },
                "wallSnapped": { "type": "boolean", "default": false },
                "wallSide": { "type": "string", "enum": ["N", "E", "S", "W"] },
                "material": {
                  "type": "object",
                  "description": "소품 PBR 텍스처 프리셋 및 색조",
                  "properties": {
                    "preset": { "type": "string", "enum": ["wood", "rustedMetal", "surgicalSteel", "concrete"], "default": "wood" },
                    "tint": { "type": "string" }
                  }
                },
                "gimmick": {
                  "type": "object",
                  "description": "물리적 단서 관찰 기믹 (시계 각도, 컵 손잡이 방향 등)",
                  "properties": {
                    "kind": { "type": "string", "enum": ["clock-angle", "cup-handle", "portrait-pointer", "blood-marking", "book-spine", "none", "custom"] },
                    "data": { "type": "object" },
                    "description": { "type": "string" }
                  }
                },
                "transform": {
                  "type": "object",
                  "required": ["pos"],
                  "properties": {
                    "pos": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
                    "rot": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3, "default": [0, 0, 0] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "passages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "fromSpaceId", "toSpaceId", "door"],
        "properties": {
          "id": { "type": "string" },
          "fromSpaceId": { "type": "string" },
          "toSpaceId": { "type": "string" },
          "directionality": { "type": "string", "enum": ["OneWay", "TwoWay"], "default": "TwoWay" },
          "traverseCost": { "type": "string", "enum": ["Walk", "Crawl", "Climb", "Slide"], "default": "Walk" },
          "door": {
            "type": "object",
            "required": ["id", "type"],
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string", "enum": ["StandardDoor", "SecretBookcase", "FloorHatch", "EMLockDoor"] },
              "isLocked": { "type": "boolean", "default": true },
              "transform": {
                "type": "object",
                "properties": {
                  "pos": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
                  "rot": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
                }
              }
            }
          }
        }
      }
    },
    "logicGraph": {
      "type": "object",
      "required": ["clues", "problems", "gates"],
      "properties": {
        "clues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "payload"],
            "properties": {
              "id": { "type": "string" },
              "propRef": { "type": "string" },
              "payload": { "type": "string" },
              "carrierType": { "type": "string", "enum": ["Text", "PhysicalState", "Trace", "AudioVisual"], "default": "Text" }
            }
          }
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "consumes", "rule", "outputGate"],
            "properties": {
              "id": { "type": "string" },
              "consumes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "rule": { "type": "string" },
              "outputGate": { "type": "string" }
            }
          }
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "condition", "unlocks"],
            "properties": {
              "id": { "type": "string" },
              "interfaceType": { "type": "string", "enum": ["MechanicalLock", "DirectionalLock", "ElectronicKeypad", "SensorSwitch", "ItemSocket", "PhysicalMechanism"], "default": "MechanicalLock" },
              "condition": { "type": "string" },
              "requiredItemId": { "type": "string", "description": "해금에 필요한 소지 아이템 ID (선택)" },
              "mechanism": {
                "type": "object",
                "description": "물리 장치 조작 스펙 (UI 하드코딩 대신 RaC 계약으로 선언)",
                "required": ["kind", "targetState"],
                "properties": {
                  "kind": { "type": "string", "enum": ["rotary-dial", "clock-hands", "balance-scale", "uv-scan", "pressure-valve", "custom"] },
                  "params": { "type": "object" },
                  "targetState": {},
                  "tolerance": { "type": "number", "default": 0 }
                }
              },
              "unlocks": { "type": "string", "description": "해금할 doorId 또는 containerId" },
              "isOpen": { "type": "boolean", "default": false }
            }
          }
        },
        "containers": {
          "type": "array",
          "description": "단서 또는 아이템을 은닉하고 있는 서랍/금고 보관함",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "isOpen": { "type": "boolean", "default": false },
              "containsClueId": { "type": "string" },
              "containsItemId": { "type": "string", "description": "개방 시 플레이어 인벤토리에 지급되는 아이템 ID" }
            }
          }
        },
        "items": {
          "type": "array",
          "description": "플레이어가 획득·소지·적용할 수 있는 물리 아이템 (정체성은 자유롭게, 효과는 닫힌 4원자로 정의)",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" },
              "tags": { "type": "array", "items": { "type": "string" } },
              "consumable": { "type": "boolean", "default": true },
              "visual": { "type": "string", "description": "아이콘/프리셋 식별자" }
            }
          }
        },
        "interactions": {
          "type": "array",
          "description": "아이템을 대상(Gate/Prop/Container/Item)에 적용했을 때의 닫힌 세계 결정론적 상태 전이 4원자",
          "items": {
            "type": "object",
            "required": ["id", "itemId", "targetId", "effect"],
            "properties": {
              "id": { "type": "string" },
              "itemId": { "type": "string" },
              "targetId": { "type": "string", "description": "적용 대상 ID (Gate, Door, Prop, Container 또는 조합할 다른 Item ID)" },
              "effect": { "type": "string", "enum": ["unlock", "revealClue", "activate", "combine"] },
              "resultId": { "type": "string", "description": "revealClue 시 노출할 clueId, combine 시 생성할 itemId, activate 시 활성화할 propId/gateId" },
              "message": { "type": "string" }
            }
          }
        }
      }
    },
    "director": {
      "type": "object",
      "description": "실시간 물리 환경(조명, 사운드, 문) 및 극중 인물 개입을 지배하는 가상 연출자 설정",
      "properties": {
        "timeLimitMinutes": { "type": "integer", "default": 60 },
        "tensionLevel": { "type": "integer", "minimum": 1, "maximum": 5, "default": 1 },
        "panicThresholdFailures": { "type": "integer", "default": 2 },
        "persona": {
          "type": "object",
          "description": "극중 등장인물 페르소나 (분장·말투·역할)",
          "properties": {
            "name": { "type": "string" },
            "role": { "type": "string" },
            "tone": { "type": "string" }
          }
        },
        "rules": {
          "type": "array",
          "description": "플레이어 상태 관측 기반 결정론적 개입 규칙 (LLM 훅 확장 가능)",
          "items": {
            "type": "object",
            "required": ["id", "trigger", "action"],
            "properties": {
              "id": { "type": "string" },
              "trigger": {
                "type": "object",
                "required": ["kind"],
                "properties": {
                  "kind": { "type": "string", "enum": ["stallSeconds", "consecutiveFailures", "roomEntered", "helpRequested"] },
                  "threshold": { "type": "number" },
                  "spaceId": { "type": "string" }
                }
              },
              "action": { "type": "string", "enum": ["whisper", "blackout", "nudgeHint", "lockDoor", "barter"] },
              "cooldownSeconds": { "type": "number", "default": 30 },
              "payload": { "type": "object" }
            }
          }
        }
      }
    }
  }
}
